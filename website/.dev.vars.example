# Copy to .dev.vars for `npm run preview` (wrangler pages dev). .dev.vars is gitignored.
# In production these are set as encrypted secrets in the Cloudflare dashboard (SETUP.md).

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-at-least-32-random-characters
# Who gets the Admin page (comma-separated)
ADMIN_EMAILS=you@example.com
# Local stand-in for Stripe's checkout page. Never set this in production.
TEST_CHECKOUT=1
# Optional locally: real email through Resend
# RESEND_API_KEY=
# MAIL_FROM=Zeanah Lab <hello@zeanahlab.com>
# Optional locally: Stripe test-mode keys
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
PUBLIC_URL=http://127.0.0.1:8788

# Local-only owner test account for the zeanahlab-pages-ownertest launch config (ADMIN_EMAILS=owner-test@example.test).
# It exists only in the local D1 (.wrangler/); sign up once with these on http://127.0.0.1:8789.
OWNER_TEST_EMAIL=owner-test@example.test
OWNER_TEST_PASSWORD=local-2i_PD7vwxpjBuutU
