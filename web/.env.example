# Copy this file to .env and fill it in. Every line is optional for local use.

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty to use a SQLite file (server/data/domenet.sqlite3).
# Set it to a Postgres URL in production, e.g. from Render, Railway, Neon or Supabase:
# DATABASE_URL=postgres://user:password@host:5432/domenet
DATABASE_URL=
# Postgres hosts that need TLS (most managed ones): set to true.
DATABASE_SSL=false

# --- Security -------------------------------------------------------------
# A long random string. REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Emails that get the admin pages (comma separated). Sign up with one of these.
ADMIN_EMAILS=you@example.com

# --- Site -----------------------------------------------------------------
PORT=8787
# The public address, used for share links. No trailing slash.
PUBLIC_URL=http://localhost:5173
# Where the PDF books live. Defaults to ../deliverables/book in this repository.
BOOKS_DIR=

# --- YouTube (optional) ---------------------------------------------------
# Your channel id (starts with UC...). The latest uploads are read from
# YouTube's public RSS feed -- no API key needed.
YOUTUBE_CHANNEL_ID=

# --- Selling the book (Stripe) --------------------------------------------
# Leave both empty and, on this computer, the shop runs a TEST checkout: no
# card, no money, just a button that marks the order paid so you can try the
# whole path. In production with these empty, the Buy button says "coming soon".
#
# dashboard.stripe.com -> Developers -> API keys -> Secret key.
# Start with the TEST key (sk_test_...); switch to the live one when ready.
STRIPE_SECRET_KEY=
# dashboard.stripe.com -> Developers -> Webhooks -> Add endpoint:
#   URL     https://YOUR-SITE/api/stripe/webhook
#   Events  checkout.session.completed
# then copy its "Signing secret" (whsec_...) here.
STRIPE_WEBHOOK_SECRET=
