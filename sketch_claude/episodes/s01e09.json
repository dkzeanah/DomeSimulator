  {
   "k": "line",
   "who": "anna",
   "text": "Mr. Yarrow, you can't stay. Your roof's older than my dad. Come to the dome. Please.",
   "act": "talk",
   "expr": "sad",
   "cam": {
    "kind": "ots",
    "over": "anna",
    "at": "yarrow",
    "lens": 50
   }
  },
  {
   "k": "line",
   "who": "yarrow",
   "text": "I've grown those roses for forty years, Anna. My wife planted the first one. I'm not leaving them to a wind.",
   "act": "peek",
   "cam": {
    "kind": "single",
    "who": "yarrow",
    "size": "close"
   }
  },
  {
   "k": "line",
   "who": "anna",
   "text": "Bean would want you to come.",
   "act": "idle",
   "cam": {
    "kind": "single",
    "who": "anna",
    "size": "close"
   }
  },
  {
   "k": "line",
   "who": "yarrow",
   "text": "Bean is with her parents, two hundred miles inland, where sensible people are.",
   "act": "peek",
   "cam": {
    "kind": "single",
    "who": "yarrow",
    "size": "close",
    "toward": "anna"
   }
  },
  {
   "k": "line",
   "who": "anna",
   "text": "Then I'll come back for you. When it starts. I'll come back and get you whether you like it or not.",
   "act": "point",
   "expr": "glare",
   "cam": {
    "kind": "single",
    "who": "anna",
    "size": "medium"
   }
  },
  {
   "k": "line",
   "who": "yarrow",
   "text": "You sound like your mother.",
   "act": "peek",
   "cam": {
    "kind": "single",
    "who": "yarrow",
    "size": "close"
   }
  },
  {
