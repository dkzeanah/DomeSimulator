   "title": "",
   "frags": [
    {
     "text": "He came in hot, like a, like the current, like a kid with a plan,",
     "rate": "+18%",
     "pause": 0.3,
     "word": "hot"
    },
    {
     "text": "and every load wants the ground. Every one. It's not wrong to want it.",
     "rate": "-8%",
     "pause": 0.35,
     "word": "ground"
    },
    {
     "text": "One wire to the ground, one road, one road jams,",
     "rate": "+26%",
     "pause": 0.2,
     "word": "one road"
    },
    {
     "text": "a stick alone, a stick alone buckles, a triangle, three, the corner hands it on,",
     "rate": "+22%",
     "pause": 0.25,
     "word": "hands it on"
    },
    {
     "text": "don't tell him. Show him where it goes.",
     "rate": "-14%",
     "pause": 0.4,
     "word": "show him"
    },
    {
     "text": "Let the ground do the talking.",
     "rate": "-28%",
     "pause": 0.4,
     "word": "the ground"
    }
