    {"k": "act", "who": "maya", "act": "phone"},
    {"k": "line", "who": "maya", "text": "Okay. I found an apartment. It's a closet over a vape shop and it costs more than Dad's truck.", "act": "phone", "after": "phone"},
    {"k": "lower", "who": "maya"},
    {"k": "line", "who": "denise", "text": "Over a vape shop? You'll come home smelling like a blueberry.", "act": "hips", "cam": {"kind": "single", "who": "denise", "toward": "maya", "size": "medium"}},
    {"k": "lower", "who": "denise"},
    {"k": "line", "who": "tyler", "text": "If Maya moves out, I get her room. For my squat rack.", "act": "flex", "cam": {"kind": "single", "who": "tyler", "toward": "maya", "size": "medium", "side": -1}},
    {"k": "lower", "who": "tyler"},
    {"k": "line", "who": "cody", "text": "If Maya moves out, I get the Wi-Fi password she changed.", "act": "think", "cam": {"kind": "single", "who": "cody", "toward": "maya", "size": "medium"}},
    {"k": "lower", "who": "cody"},
    {"k": "line", "who": "maya", "text": "Nobody gets the room. I'm subletting it to a guy named Dusty.", "act": "phone", "cam": {"kind": "single", "who": "maya", "size": "close"}},
    {"k": "meme", "style": "zoom", "who": "denise", "text": "", "secs": 0.9, "sfx": "boom"},
    {"k": "walk", "who": "hank", "to": [1.3, 8.2], "speed": 1.5, "wait": false},
    {"k": "line", "who": "hank", "text": "Nobody is moving out. Nobody is subletting to Dusty. I am building this family something.", "act": "talk", "cam": {"kind": "two", "a": "hank", "b": "denise", "dist": 3.6, "side": -1}},
    {"k": "line", "who": "denise", "text": "The last thing you built was a birdhouse, Hank. The birds moved out.", "act": "hips", "cam": {"kind": "ots", "over": "hank", "at": "denise"}},
    {"k": "line", "who": "hank", "text": "Those birds had commitment issues.", "act": "shrug", "cam": {"kind": "single", "who": "hank", "toward": "denise", "size": "close"}},
    {"k": "sfx", "name": "rimshot"},
    {"k": "line", "who": "cody", "text": "Is this the triangle thing in the yard? Because right now it has more holes than Tyler's alibi.", "act": "point", "cam": {"kind": "single", "who": "cody", "size": "medium"}},
    {"k": "line", "who": "tyler", "text": "My alibi was airtight.", "act": "hips", "cam": {"kind": "single", "who": "tyler", "size": "close"}},
