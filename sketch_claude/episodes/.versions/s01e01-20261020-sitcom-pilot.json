    {"k": "scene", "name": "The patio: nobody is moving out", "at": "patio", "sun": [250, 22],
     "place": {"hank": [2.6, 8.9, 135], "denise": [-1.2, 8.2, -90], "maya": [0.0, 9.3, 180], "tyler": [-0.65, 7.1, -15], "cody": [0.7, 7.1, 20]},
