    {"k": "line", "who": "yarrow", "text": "Two panels on a dome meet at a fold of about {fold_spoken} degrees. Each stick takes half. {bevel_spoken} on one, {bevel_spoken} on the other.", "act": "peek", "cam": {"kind": "ots", "over": "hank", "at": "yarrow", "lens": 65}},
    {"k": "line", "who": "yarrow", "text": "It's like a marriage, Hank. Each of you gives a little. Neither of you gives fifteen.", "act": "peek", "cam": {"kind": "single", "who": "yarrow", "toward": "hank", "size": "close"}},
