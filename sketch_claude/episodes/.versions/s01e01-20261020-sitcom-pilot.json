    {"k": "cam", "cam": {"kind": "two", "a": "hank", "b": "denise", "dist": 3.4, "lens": 40}, "dur": 2.2, "wait": true},
    {"k": "line", "who": "denise", "text": "This isn't really about triangles, is it.", "act": "talk", "cam": {"kind": "ots", "over": "hank", "at": "denise", "lens": 50}},
    {"k": "line", "who": "hank", "text": "Maya's leaving. Tyler's leaving the second he can spell lease. And Cody has an offshore account. I'm sure of it.", "act": "talk", "cam": {"kind": "single", "who": "hank", "toward": "denise", "size": "medium"}},
    {"k": "line", "who": "denise", "text": "So you're building them somewhere to stay.", "act": "talk", "cam": {"kind": "single", "who": "denise", "toward": "hank", "size": "close"}},
    {"k": "line", "who": "hank", "text": "{sqft_words} square feet, right in the yard. Close enough to visit. Far enough that I can't hear the music.", "act": "talk", "cam": {"kind": "ots", "over": "denise", "at": "hank", "lens": 50}},
