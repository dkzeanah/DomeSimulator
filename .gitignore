# Local editor/tool state
.claude/
.vscode/

# Node dependencies (third-party libraries, never commit)
node_modules/

# Generated trailer render outputs (recreate with build_launcher_trailer.py)
deliverables/launcher_trailer/render_*/

# Rendered mermaid output; regenerate with `npm run diagrams`
docs/diagrams/

# Scratch audio intermediates. The scripts in exports/scratchpad are
# worth keeping; the raw PCM and test mixdowns they emit are large,
# regenerable byproducts and do not belong in history.
exports/scratchpad/*.raw
exports/scratchpad/*.wav
exports/scratchpad/*.pcm
