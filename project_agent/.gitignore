# Transient run state: one folder per session of logs and manifests, copies of
# files that are themselves in version control, and lock files. All of it is
# regenerated on the next run, so none of it belongs in a commit.
runs/
backups/
locks/
__pycache__/

# Derived from the observer on this computer by `sync`. It quotes the owner's own requests
# (playbook goals), so it stays out of a public repository.
kb/learned.json
